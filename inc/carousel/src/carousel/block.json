{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocklane/carousel",
	"version": "0.1.0",
	"title": "Carousel",
	"category": "blocklane-carousel",
	"description": "Display a carousel using any blocks as slides.",
	"keywords": [ "slider", "slideshow", "gallery", "slides" ],
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"blockGap": "var:preset|spacing|40"
				}
			}
		},
		"centerNav": {
			"type": "boolean",
			"default": false
		}
	},
	"providesContext": {
		"blocklane/carouselCenterNav": "centerNav"
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"heading": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"typography": {
			"fontSize": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": {
				"__experimentalDefault": "var:preset|spacing|40"
			},
			"__experimentalDefaultControls": {
				"padding": true,
				"blockGap": true
			}
		},
		"layout": {
			"allowSwitching": false,
			"allowEditing": false,
			"default": {
				"type": "default"
			}
		}
	},
	"textdomain": "blocklane",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"align": "wide"
		},
		"innerBlocks": [
			{
				"name": "blocklane/carousel-track",
				"attributes": {
					"slidesPerView": 2
				},
				"innerBlocks": [
					{
						"name": "blocklane/slide",
						"innerBlocks": [
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Slide one"
								}
							}
						]
					},
					{
						"name": "blocklane/slide",
						"innerBlocks": [
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Slide two"
								}
							}
						]
					}
				]
			},
			{
				"name": "blocklane/carousel-controls",
				"attributes": {
					"navType": "dots",
					"justifyContent": "center"
				}
			}
		]
	}
}

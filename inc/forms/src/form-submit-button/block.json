{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocklane/form-submit-button",
	"version": "0.1.0",
	"title": "Submit Button",
	"category": "blocklane-forms",
	"description": "Submits the form. Inherits the theme’s button styles.",
	"keywords": [ "submit", "send", "button" ],
	"ancestor": [ "blocklane/form" ],
	"usesContext": [ "blocklane/formId" ],
	"example": {},
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"busyText": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"dimensions": {
			"width": true,
			"__experimentalDefaultControls": {
				"width": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"textdomain": "blocklane",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocklane/form-input",
	"version": "0.1.0",
	"title": "Text Field",
	"category": "blocklane-forms",
	"description": "A single-line form field — text, email, phone, URL, number, date, hidden, or consent checkbox.",
	"keywords": [ "input", "field", "email", "phone", "date" ],
	"ancestor": [ "blocklane/form" ],
	"usesContext": [ "blocklane/formId" ],
	"example": {
		"attributes": {
			"label": "Email",
			"type": "email",
			"required": true
		}
	},
	"attributes": {
		"type": {
			"type": "string",
			"enum": [
				"text",
				"email",
				"tel",
				"url",
				"number",
				"date",
				"hidden",
				"checkbox"
			],
			"default": "text"
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"hideLabel": {
			"type": "boolean",
			"default": false
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"defaultValue": {
			"type": "string",
			"default": ""
		},
		"autocomplete": {
			"type": "string",
			"default": ""
		},
		"isReplyTo": {
			"type": "boolean",
			"default": false
		},
		"min": {
			"type": "string",
			"default": ""
		},
		"max": {
			"type": "string",
			"default": ""
		},
		"step": {
			"type": "string",
			"default": ""
		},
		"maxlength": {
			"type": "number"
		},
		"condition": {
			"type": "object",
			"default": {
				"enabled": false,
				"field": "",
				"operator": "is",
				"value": ""
			}
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true
		}
	},
	"selectors": {
		"root": ".wp-block-blocklane-form-input",
		"color": ".wp-block-blocklane-form-input .blocklane-form__control",
		"border": ".wp-block-blocklane-form-input .blocklane-form__control",
		"typography": ".wp-block-blocklane-form-input"
	},
	"textdomain": "blocklane",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

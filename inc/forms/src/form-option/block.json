{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blocklane/form-option",
	"version": "0.1.0",
	"title": "Choice",
	"category": "blocklane-forms",
	"description": "One choice inside a group or dropdown of choices.",
	"parent": [ "blocklane/form-group", "blocklane/form-select" ],
	"usesContext": [
		"blocklane/formId",
		"blocklane/fieldType",
		"blocklane/fieldName",
		"blocklane/fieldLegend",
		"blocklane/fieldRequired"
	],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"value": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"textdomain": "blocklane",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}

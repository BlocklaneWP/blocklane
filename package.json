{
    "name": "blocklane",
    "version": "1.0.0",
    "description": "Blocklane Pro \u2014 the Pro companion plugin for the FSE block theme.",
    "author": "Blocklane LLC",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "npm run build:seo && npm run build:forms && npm run build:onboarding && npm run build:extensions && npm run build:site-password && npm run build:mega-menu-standin && npm run build:form-step-standin && npm run build:popups",
        "build:seo": "wp-scripts build --webpack-src-dir=inc/seo/src --output-path=inc/seo/build",
        "build:forms": "wp-scripts build --webpack-src-dir=inc/forms/src --output-path=inc/forms/build --webpack-copy-php --experimental-modules",
        "start:forms": "wp-scripts start --webpack-src-dir=inc/forms/src --output-path=inc/forms/build --webpack-copy-php --experimental-modules",
        "start:seo": "wp-scripts start --webpack-src-dir=inc/seo/src --output-path=inc/seo/build",
        "build:onboarding": "wp-scripts build --webpack-src-dir=inc/onboarding/src --output-path=inc/onboarding/build && cp inc/onboarding/src/fonts/OFL-Manrope.txt inc/onboarding/src/fonts/OFL-Unbounded.txt inc/onboarding/build/fonts/",
        "build:extensions": "wp-scripts build --config inc/extensions/webpack.config.js",
        "build:site-password": "wp-scripts build --webpack-src-dir=inc/site-lock/src --output-path=inc/site-lock/build",
        "build:mega-menu-standin": "wp-scripts build --webpack-src-dir=inc/mega-menu-standin/src --output-path=inc/mega-menu-standin/build",
        "build:form-step-standin": "wp-scripts build --webpack-src-dir=inc/form-step-standin/src --output-path=inc/form-step-standin/build",
        "build:popups": "wp-scripts build --webpack-src-dir=inc/popups/src --output-path=inc/popups/build",
        "start:onboarding": "wp-scripts start --webpack-src-dir=inc/onboarding/src --output-path=inc/onboarding/build",
        "start:extensions": "wp-scripts start --config inc/extensions/webpack.config.js",
        "start:mega-menu-standin": "wp-scripts start --webpack-src-dir=inc/mega-menu-standin/src --output-path=inc/mega-menu-standin/build",
        "start:form-step-standin": "wp-scripts start --webpack-src-dir=inc/form-step-standin/src --output-path=inc/form-step-standin/build",
        "lint:js": "wp-scripts lint-js inc --max-warnings=0",
        "lint:css": "wp-scripts lint-style 'inc/**/*.css' 'inc/**/*.scss'"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@wordpress/babel-preset-default": "^8.55.0",
        "@wordpress/eslint-plugin": "^27.0.0",
        "@wordpress/icons": "^17.0.0",
        "@wordpress/interface": "^10.2.0",
        "@wordpress/jest-preset-default": "^14.2.0",
        "@wordpress/scripts": "^36.0.0",
        "babel-jest": "^30.5.0",
        "copy-webpack-plugin": "^14.0.0",
        "eslint-plugin-jest": "^29.16.6",
        "jest": "^30.5.0",
        "jest-environment-jsdom": "^30.5.0"
    },
    "dependencies": {
        "@wordpress/dataviews": "19.1.0",
        "classnames": "^2.5.1",
        "stylis": "^4.4.0",
        "embla-carousel": "^8.6.0",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-auto-scroll": "^8.6.0",
        "embla-carousel-auto-height": "^8.6.0",
        "embla-carousel-fade": "^8.6.0",
        "embla-carousel-wheel-gestures": "^8.1.0"
    },
    "//": "overrides.markdown-it: GHSA-253c-mchw-3w2r (Dependabot #167/#168). markdownlint 0.25.1 under @wordpress/scripts pins markdown-it 12.3.2 exactly; drop this override when wp-scripts' markdownlint-cli resolves markdown-it >= 14.3.1 on its own. bin/lint-md-smoke.sh proves the linter still runs. overrides.markdownlint-cli.js-yaml: GHSA (Dependabot #183/#184, js-yaml >= 5.0.0 <= 5.4.0, maxTotalMergeKeys does not limit CPU for empty merge sources). markdownlint-cli 0.49.1 (latest) pins js-yaml ~5.2.1; scoped to markdownlint-cli so the 3.x/4.x consumers keep their majors; drop it when markdownlint-cli allows >= 5.4.1.",
    "overrides": {
        "qs": "^6.16.0",
        "markdown-it": "^14.3.1",
        "markdownlint-cli": {
            "js-yaml": "^5.4.1"
        }
    }
}

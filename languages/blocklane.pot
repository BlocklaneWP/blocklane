#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:16
msgid "Responsive Controls"
msgstr ""

#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:17
msgid "Set a display order and a max width per breakpoint, inside core’s Layout and Dimensions panels."
msgstr ""

#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:22
msgid "Responsive Controls adds tablet and mobile overrides for the two things core’s style engine still leaves out: the display order of a block inside a Row, Stack or Columns parent, and a max width on any block with a minimum-height control. Both live inside the existing Layout and Dimensions panels and follow the editor’s device preview."
msgstr ""

#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:26
#: inc/onboarding/src/screens/extensions/rows/transparent-header.js:26
msgid "Features"
msgstr ""

#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:30
msgid "Display order - Reorder a block per breakpoint without duplicating it"
msgstr ""

#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:34
msgid "Max width - Cap a block’s width per breakpoint"
msgstr ""

#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:38
msgid "Device preview - Switch the editor to tablet or mobile and the fields show that breakpoint’s values"
msgstr ""

#: inc/onboarding/src/screens/extensions/rows/responsive-controls.js:42
msgid "Your theme’s breakpoints - The tablet and mobile widths come from your theme settings and can be edited inline"
